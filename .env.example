# Copy to `.env` and fill in. Every value is optional — the defaults in
# src/self_rag/config.py are used for anything left unset.

# --- Language model -----------------------------------------------------------
# Supported providers: google_genai, groq
SELF_RAG_LLM_PROVIDER=google_genai
SELF_RAG_LLM_MODEL=gemini-2.5-flash

# Only the key for the provider you selected is required.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Free tiers are rate limited. Lower this if you see 429 responses.
SELF_RAG_LLM_REQUESTS_PER_SECOND=0.5

# --- Storage ------------------------------------------------------------------
# All runtime data (markdown, parent chunks, vector db, checkpoints) lives here.
SELF_RAG_DATA_DIR=data

# --- Debugging ----------------------------------------------------------------
# Print every graph node transition to the terminal.
SELF_RAG_EXECUTION_LOGGING_ENABLED=false

# --- Optional Langfuse tracing ------------------------------------------------
SELF_RAG_LANGFUSE_ENABLED=false
SELF_RAG_LANGFUSE_PUBLIC_KEY=
SELF_RAG_LANGFUSE_SECRET_KEY=
SELF_RAG_LANGFUSE_BASE_URL=http://localhost:3000
